# ── CONFIGURACIÓN DE EJEMPLO DE VARIABLES DE ENTORNO ─────────────────
# Copia este archivo como '.env' y completa con tus datos reales.
# NUNCA SUBAS EL ARCHIVO '.env' A GITHUB.

# Binance API Keys
BINANCE_API_KEY=tu_binance_api_key_aqui
BINANCE_API_SECRET=tu_binance_api_secret_aqui

# true = Binance Testnet (Modo Prueba) | false = Binance Real
TESTNET=true

# Capital asignado para gestión de riesgo
INITIAL_CAPITAL=100

# Par por defecto y temporalidad
SYMBOL=BTCUSDT
TIMEFRAME=1d

# Telegram Notifications
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui

# ── Binance FUTURES (USD-M) ────────────────────────────────────────────
# spot = engine/testnet_trader.py (solo LONG) | futures = engine/futures_trader.py (LONG+SHORT)
MARKET_TYPE=spot

# Keys DISTINTAS a las de Spot de arriba. Se generan en https://testnet.binancefuture.com
BINANCE_FUTURES_API_KEY=tu_binance_futures_api_key_aqui
BINANCE_FUTURES_API_SECRET=tu_binance_futures_api_secret_aqui

# true = Futures Testnet (dinero ficticio) | false = Futures real (dinero real)
FUTURES_TESTNET=true

# Apalancamiento (entero) y tipo de margen ("ISOLATED" o "CROSSED")
LEVERAGE=2
MARGIN_TYPE=ISOLATED

# Símbolos donde se permite abrir SHORT real (separados por coma, sin espacios).
# Revalida con robustness_report.py antes de añadir un símbolo aquí.
SHORT_ENABLED_SYMBOLS=ETHUSDT,SOLUSDT,ADAUSDT,DOGEUSDT
